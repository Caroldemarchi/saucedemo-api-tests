        {
          "name": "Criar novo usuário",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Usuário criado com dados corretos', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.name).to.eql('QA Engineer');",
                  "    pm.expect(json.job).to.eql('Automação de Testes');",
                  "    pm.expect(json.id).to.be.a('string');",
                  "    pm.expect(json.createdAt).to.be.a('string');",
                  "    pm.collectionVariables.set('newUserId', json.id);",
                  "});",
                  "",
                  "pm.test('Campo createdAt é uma data ISO válida', function () {",
                  "    const { createdAt } = pm.response.json();",
                  "    pm.expect(new Date(createdAt).toString()).to.not.eql('Invalid Date');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
