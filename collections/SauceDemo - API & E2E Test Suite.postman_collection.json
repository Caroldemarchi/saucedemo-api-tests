    {
      "name": "👤 Usuários",
      "item": [
        {
          "name": "Listar usuários - página 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Estrutura de paginação correta', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('page');",
                  "    pm.expect(json).to.have.property('data');",
                  "    pm.expect(json.page).to.eql(1);",
                  "    pm.expect(json.data).to.be.an('array').and.not.empty;",
                  "});",
                  "",
                  "pm.test('Cada usuário tem campos obrigatórios', function () {",
                  "    const users = pm.response.json().data;",
                  "    users.forEach(user => {",
                  "        pm.expect(user).to.have.property('id');",
                  "        pm.expect(user).to.have.property('email');",
                  "        pm.expect(user).to.have.property('first_name');",
                  "        pm.expect(user).to.have.property('last_name');",
                  "    });",
                  "});",
                  "",
                  "pm.test('Email dos usuários tem formato válido', function () {",
                  "    const users = pm.response.json().data;",
                  "    const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;",
                  "    users.forEach(u => pm.expect(u.email).to.match(emailRegex));",
                  "});",
                  "",
                  "const firstUser = pm.response.json().data[0];",
                  "pm.environment.set('userId', firstUser.id);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiUrl}}/users?page=1",
              "host": [
                "{{apiUrl}}"
              ],
              "path": [
                "users"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            }
          },
          "response": []
        },
